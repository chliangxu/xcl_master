from PyQt5.QtWidgets import (QWidget, QVBoxLayout, QHBoxLayout, QTabWidget,
                             QLabel, QTreeWidget, QTreeWidgetItem, QPushButton,
                             QTableWidget, QTableWidgetItem, QHeaderView, QLineEdit,
                             QTextEdit, QDialog, QDialogButtonBox, QCheckBox, QGroupBox,
                             QSplitter, QMessageBox, QListWidget, QListWidgetItem)
from PyQt5.QtCore import Qt, pyqtSignal
from src.common.base import BaseWidget


class PermissionModuleView(BaseWidget):
    permission_changed = pyqtSignal()
    group_selected = pyqtSignal(int)
    add_user_button_clicked = pyqtSignal()
    group_create_requested = pyqtSignal(str, str)
    group_permission_updated = pyqtSignal(int, list)
    user_add_to_group = pyqtSignal(str, int)
    user_remove_from_group = pyqtSignal(str, int)

    def __init__(self, parent=None):
        self.current_group_id = None
        super().__init__(parent)

    def init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(10, 10, 10, 10)
        layout.setSpacing(5)

        self.tab_widget = QTabWidget()

        self.current_user_tab = self._create_current_user_tab()
        self.group_manage_tab = self._create_group_manage_tab()

        self.tab_widget.addTab(self.current_user_tab, "当前用户权限")
        self.tab_widget.addTab(self.group_manage_tab, "用户组管理")

        layout.addWidget(self.tab_widget)

    def _create_current_user_tab(self):
        widget = QWidget()
        layout = QVBoxLayout(widget)
        layout.setContentsMargins(10, 10, 10, 10)

        header_layout = QHBoxLayout()
        self.current_user_label = QLabel("当前用户: ")
        header_layout.addWidget(self.current_user_label)
        header_layout.addStretch()

        refresh_btn = QPushButton("刷新")
        refresh_btn.clicked.connect(self.permission_changed.emit)
        header_layout.addWidget(refresh_btn)

        layout.addLayout(header_layout)

        group_box = QGroupBox("所属用户组")
        group_layout = QVBoxLayout(group_box)
        self.user_groups_list = QTableWidget()
        self.user_groups_list.setColumnCount(1)
        self.user_groups_list.setHorizontalHeaderLabels(["用户组名称"])
        self.user_groups_list.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
        self.user_groups_list.setSelectionBehavior(QTableWidget.SelectRows)
        self.user_groups_list.setEditTriggers(QTableWidget.NoEditTriggers)
        group_layout.addWidget(self.user_groups_list)
        layout.addWidget(group_box)

        perm_box = QGroupBox("拥有的模块权限")
        perm_layout = QVBoxLayout(perm_box)
        self.user_permissions_tree = QTreeWidget()
        self.user_permissions_tree.setHeaderLabels(["模块名称", "模块Key"])
        self.user_permissions_tree.header().setSectionResizeMode(0, QHeaderView.Stretch)
        perm_layout.addWidget(self.user_permissions_tree)
        layout.addWidget(perm_box)

        return widget

    def _create_group_manage_tab(self):
        widget = QWidget()
        layout = QHBoxLayout(widget)
        layout.setContentsMargins(0, 0, 0, 0)

        splitter = QSplitter(Qt.Horizontal)

        left_panel = self._create_group_list_panel()
        right_panel = self._create_group_detail_panel()

        splitter.addWidget(left_panel)
        splitter.addWidget(right_panel)
        splitter.setStretchFactor(0, 1)
        splitter.setStretchFactor(1, 2)

        layout.addWidget(splitter)

        return widget

    def _create_group_list_panel(self):
        panel = QWidget()
        layout = QVBoxLayout(panel)
        layout.setContentsMargins(10, 10, 10, 10)

        header = QLabel("用户组列表")
        layout.addWidget(header)

        create_btn = QPushButton("+ 新建用户组")
        create_btn.clicked.connect(self._on_create_group_clicked)
        layout.addWidget(create_btn)

        self.groups_table = QTableWidget()
        self.groups_table.setColumnCount(3)
        self.groups_table.setHorizontalHeaderLabels(["组名", "用户数", "权限数"])
        self.groups_table.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
        self.groups_table.setSelectionBehavior(QTableWidget.SelectRows)
        self.groups_table.setSelectionMode(QTableWidget.SingleSelection)
        self.groups_table.setEditTriggers(QTableWidget.NoEditTriggers)
        self.groups_table.itemSelectionChanged.connect(self._on_group_selection_changed)
        layout.addWidget(self.groups_table)

        return panel

    def _create_group_detail_panel(self):
        panel = QWidget()
        layout = QVBoxLayout(panel)
        layout.setContentsMargins(10, 10, 10, 10)

        self.group_detail_label = QLabel("选择一个用户组查看详情")
        layout.addWidget(self.group_detail_label)

        tabs = QTabWidget()

        users_tab = self._create_group_users_tab()
        permissions_tab = self._create_group_permissions_tab()

        tabs.addTab(users_tab, "组内用户")
        tabs.addTab(permissions_tab, "组权限")

        layout.addWidget(tabs)

        return panel

    def _create_group_users_tab(self):
        widget = QWidget()
        layout = QVBoxLayout(widget)

        toolbar = QHBoxLayout()

        add_user_btn = QPushButton("添加用户")
        add_user_btn.clicked.connect(self._on_add_user_clicked)
        toolbar.addWidget(add_user_btn)

        layout.addLayout(toolbar)

        self.group_users_table = QTableWidget()
        self.group_users_table.setColumnCount(2)
        self.group_users_table.setHorizontalHeaderLabels(["用户ID", "操作"])
        self.group_users_table.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
        self.group_users_table.setSelectionBehavior(QTableWidget.SelectRows)
        self.group_users_table.setEditTriggers(QTableWidget.NoEditTriggers)
        layout.addWidget(self.group_users_table)

        return widget

    def _create_group_permissions_tab(self):
        widget = QWidget()
        layout = QVBoxLayout(widget)

        toolbar = QHBoxLayout()
        toolbar.addStretch()
        save_btn = QPushButton("保存权限")
        save_btn.clicked.connect(self._on_save_permissions_clicked)
        toolbar.addWidget(save_btn)
        layout.addLayout(toolbar)

        self.permissions_tree = QTreeWidget()
        self.permissions_tree.setHeaderLabels(["模块名称", "模块Key"])
        self.permissions_tree.header().setSectionResizeMode(0, QHeaderView.Stretch)
        layout.addWidget(self.permissions_tree)

        return widget

    def _on_create_group_clicked(self):
        dialog = QDialog(self)
        dialog.setWindowTitle("新建用户组")
        dialog.setMinimumWidth(400)

        layout = QVBoxLayout(dialog)

        name_layout = QHBoxLayout()
        name_layout.addWidget(QLabel("组名:"))
        name_input = QLineEdit()
        name_layout.addWidget(name_input)
        layout.addLayout(name_layout)

        desc_layout = QVBoxLayout()
        desc_layout.addWidget(QLabel("描述:"))
        desc_input = QTextEdit()
        desc_input.setMaximumHeight(100)
        desc_layout.addWidget(desc_input)
        layout.addLayout(desc_layout)

        buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        buttons.accepted.connect(dialog.accept)
        buttons.rejected.connect(dialog.reject)
        layout.addWidget(buttons)

        if dialog.exec_() == QDialog.Accepted:
            group_name = name_input.text().strip()
            description = desc_input.toPlainText().strip()
            if group_name:
                self.group_create_requested.emit(group_name, description)

    def _on_group_selection_changed(self):
        selected = self.groups_table.selectedItems()
        if selected:
            row = selected[0].row()
            group_id = self.groups_table.item(row, 0).data(Qt.UserRole)
            self.current_group_id = group_id
            self.group_selected.emit(group_id)

    def _on_add_user_clicked(self):
        if not self.current_group_id:
            QMessageBox.warning(self, "警告", "请先选择一个用户组")
            return
        self.add_user_button_clicked.emit()

    def show_user_selection_dialog(self, available_users: list):
        dialog = QDialog(self)
        dialog.setWindowTitle("选择用户")
        dialog.setMinimumWidth(400)
        dialog.setMinimumHeight(500)

        layout = QVBoxLayout(dialog)
        search_layout = QHBoxLayout()
        search_layout.addWidget(QLabel("搜索:"))
        search_input = QLineEdit()
        search_input.setPlaceholderText("输入用户ID筛选...")
        search_layout.addWidget(search_input)
        layout.addLayout(search_layout)

        user_list = QListWidget()
        user_list.setSelectionMode(QListWidget.SingleSelection)
        layout.addWidget(user_list)

        def update_user_list(filter_text=""):
            user_list.clear()
            for user_id in available_users:
                if not filter_text or filter_text.lower() in user_id.lower():
                    item = QListWidgetItem(user_id)
                    user_list.addItem(item)

        update_user_list()

        search_input.textChanged.connect(update_user_list)

        buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        buttons.accepted.connect(dialog.accept)
        buttons.rejected.connect(dialog.reject)
        layout.addWidget(buttons)

        if dialog.exec_() == QDialog.Accepted:
            selected_items = user_list.selectedItems()
            if selected_items:
                user_id = selected_items[0].text()
                self.user_add_to_group.emit(user_id, self.current_group_id)

    def _on_save_permissions_clicked(self):
        if not self.current_group_id:
            QMessageBox.warning(self, "警告", "请先选择一个用户组")
            return

        module_ids = []
        self._collect_checked_modules(self.permissions_tree.invisibleRootItem(), module_ids)

        self.group_permission_updated.emit(self.current_group_id, module_ids)

    def _collect_checked_modules(self, item, module_ids):
        for i in range(item.childCount()):
            child = item.child(i)
            if child.checkState(0) == Qt.Checked:
                module_id = child.data(0, Qt.UserRole)
                if module_id:
                    module_ids.append(module_id)
            self._collect_checked_modules(child, module_ids)

    def set_current_user(self, user_name: str):
        self.current_user_label.setText(f"当前用户: {user_name}")

    def set_user_groups(self, groups):
        self.user_groups_list.setRowCount(0)
        for group in groups:
            row = self.user_groups_list.rowCount()
            self.user_groups_list.insertRow(row)
            self.user_groups_list.setItem(row, 0, QTableWidgetItem(group.group_name))

    def set_user_permissions(self, modules):
        self.user_permissions_tree.clear()
        for module in modules:
            self._add_module_item(self.user_permissions_tree, module, enabled=False)

    def set_all_groups(self, groups):
        self.groups_table.setRowCount(0)
        for group in groups:
            row = self.groups_table.rowCount()
            self.groups_table.insertRow(row)

            item = QTableWidgetItem(group.group_name)
            item.setData(Qt.UserRole, group.id)
            self.groups_table.setItem(row, 0, item)
            self.groups_table.setItem(row, 1, QTableWidgetItem(str(group.user_count)))
            self.groups_table.setItem(row, 2, QTableWidgetItem(str(len(group.module_permissions))))

    def set_group_detail(self, group_name: str):
        self.group_detail_label.setText(f"用户组: {group_name}")

    def set_group_users(self, users, group_id):
        self.group_users_table.setRowCount(0)
        for user_id in users:
            row = self.group_users_table.rowCount()
            self.group_users_table.insertRow(row)
            self.group_users_table.setItem(row, 0, QTableWidgetItem(user_id))

            remove_btn = QPushButton("移除")
            remove_btn.clicked.connect(lambda checked, uid=user_id, gid=group_id:
                                       self.user_remove_from_group.emit(uid, gid))
            self.group_users_table.setCellWidget(row, 1, remove_btn)

    def set_group_permissions(self, all_modules, selected_module_keys):
        self.permissions_tree.clear()
        selected_set = set(selected_module_keys)
        for module in all_modules:
            self._add_module_item(self.permissions_tree, module, enabled=True, selected_keys=selected_set)

    def _add_module_item(self, parent, module, enabled=True, selected_keys=None):
        item = QTreeWidgetItem(parent)
        item.setText(0, module.module_name)
        item.setText(1, module.module_key)
        item.setData(0, Qt.UserRole, module.id)

        if enabled:
            item.setFlags(item.flags() | Qt.ItemIsUserCheckable)
            if selected_keys and module.module_key in selected_keys:
                item.setCheckState(0, Qt.Checked)
            else:
                item.setCheckState(0, Qt.Unchecked)

        for child in module.children:
            self._add_module_item(item, child, enabled, selected_keys)

        item.setExpanded(True)
        return item

    def apply_styles(self):
        pass
