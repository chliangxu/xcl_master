from PyQt5.QtWidgets import QWidget, QVBoxLayout, QTabWidget, QLabel
from src.common.base import BaseWidget


class TaskModuleView(BaseWidget):
    def init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)

        self.tab_widget = QTabWidget()

        task_list_tab = QWidget()
        task_list_layout = QVBoxLayout(task_list_tab)
        task_list_layout.addWidget(QLabel("任务列表"))

        self.tab_widget.addTab(task_list_tab, "任务列表")

        layout.addWidget(self.tab_widget)

    def apply_styles(self):
        cfg = self.cfg()

        self.setStyleSheet(f"""
            TaskModuleView {{
                background-color: {cfg.colors.background};
            }}
            QTabWidget::pane {{
                border: 1px solid {self.get_border_color()};
                background-color: {cfg.colors.background};
            }}
            QTabBar::tab {{
                background-color: {cfg.colors.surface};
                color: {cfg.colors.text_secondary};
                padding: 10px 20px;
                margin-right: 2px;
                border: 1px solid {self.get_border_color()};
                border-bottom: none;
            }}
            QTabBar::tab:selected {{
                background-color: {cfg.colors.background};
                color: {self.get_primary_color()};
                border-bottom: 2px solid {self.get_primary_color()};
            }}
            QTabBar::tab:hover {{
                background-color: {cfg.colors.surface_hover};
            }}
        """)
