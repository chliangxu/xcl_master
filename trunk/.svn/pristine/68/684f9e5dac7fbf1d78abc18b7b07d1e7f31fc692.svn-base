import sys
from PyQt5.QtWidgets import QApplication, QMainWindow, QPushButton, QLabel
from PyQt5 import uic
from PyQt5.QtGui import QFont
import os


class TaskBugView(QMainWindow):
    def __init__(self):
        super().__init__()  # 初始化父类QWidget
        # 动态加载UI文件（.ui文件路径需与代码同级或指定绝对路径）
        # uic.loadUi("E:\CGame\cgameworkstudio\\trunk\src\modules\\task\\view\BUG.ui", self)
        uic.loadUi("./src/modules/task/view/BUG.ui", self)

        # 连接按钮点击事件到槽函数（自定义跳转逻辑）
        self.pushButton.clicked.connect(self.open_tapd)
        self.username_label_bug = self.findChild(QLabel, "label")
        self.username_label_need = self.findChild(QLabel, "label_2")
        self.username_label_bug.setStyleSheet("color: #0000FF;")
        self.username_label_bug.setFont(QFont("Arial", 18))
        self.username_label_need.setStyleSheet("color: #0000FF;")
        self.username_label_need.setFont(QFont("Arial", 18))
        self.tapd_pushbutton = self.findChild(QPushButton, "pushButton")
        self.tapd_pushbutton.setFont(QFont("Arial", 18))

    def open_tapd(self):
        """“跳转TAPD”按钮的点击逻辑"""
        print("执行跳转TAPD操作...")
        import webbrowser
        webbrowser.open("https://tapd.woa.com/tapd_fe/20386762/bug/list?confId=1020386762105611698")

if __name__ == '__main__':
    app = QApplication(sys.argv)
    window = TaskBugView()
    window.show()
    sys.exit(app.exec_())




