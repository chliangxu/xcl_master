from PyQt5.QtWidgets import QWidget, QVBoxLayout, QTabWidget, QLabel
from src.common.base import BaseWidget


class NotificationModuleView(BaseWidget):
    def init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        
        self.tab_widget = QTabWidget()
        
        follow_tab = QWidget()
        follow_layout = QVBoxLayout(follow_tab)
        follow_layout.addWidget(QLabel("关注通知"))
        
        version_tab = QWidget()
        version_layout = QVBoxLayout(version_tab)
        version_layout.addWidget(QLabel("版本通知"))
        
        build_error_tab = QWidget()
        build_error_layout = QVBoxLayout(build_error_tab)
        build_error_layout.addWidget(QLabel("构建报错通知"))
        
        self.tab_widget.addTab(follow_tab, "关注通知")
        self.tab_widget.addTab(version_tab, "版本通知")
        self.tab_widget.addTab(build_error_tab, "构建报错通知")
        
        layout.addWidget(self.tab_widget)
        
    def apply_styles(self):
        cfg = self.cfg()
        
        self.setStyleSheet(f"""
            NotificationModuleView {{
                background-color: {cfg.colors.background};
            }}
            QTabWidget::pane {{
                border: 1px solid {self.get_border_color()};
                background-color: {cfg.colors.background};
            }}
            QTabBar::tab {{
                background-color: {cfg.colors.surface};
                color: {cfg.colors.text_secondary};
                padding: 10px 20px;
                margin-right: 2px;
                border: 1px solid {self.get_border_color()};
                border-bottom: none;
            }}
            QTabBar::tab:selected {{
                background-color: {cfg.colors.background};
                color: {self.get_primary_color()};
                border-bottom: 2px solid {self.get_primary_color()};
            }}
            QTabBar::tab:hover {{
                background-color: {cfg.colors.surface_hover};
            }}
        """)
