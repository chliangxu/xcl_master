class PermissionEvents:
    # 用户组事件
    GROUP_SELECTED = "permission.group.selected"
    GROUP_CREATE_REQUESTED = "permission.group.create_requested"
    GROUP_CREATED = "permission.group.created"

    # 用户事件
    USER_ADD_TO_GROUP_REQUESTED = "permission.user.add_to_group_requested"
    USER_ADDED_TO_GROUP = "permission.user.added_to_group"
    USER_REMOVE_FROM_GROUP_REQUESTED = "permission.user.remove_from_group_requested"
    USER_REMOVED_FROM_GROUP = "permission.user.removed_from_group"

    # 权限事件
    PERMISSION_CHANGED = "permission.permission_changed"
    GROUP_PERMISSION_UPDATE_REQUESTED = "permission.group_permission.update_requested"
    GROUP_PERMISSION_UPDATED = "permission.group_permission.updated"

    # 第三方权限事件
    THIRD_PARTY_URL_OPEN_REQUESTED = "permission.third_party.url_open_requested"
